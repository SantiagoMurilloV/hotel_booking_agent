# LLM provider (swappable: deepseek | anthropic | groq | openai ...)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-...

# Slack incoming webhook (opcional: sin él, las notificaciones van a consola)
SLACK_WEBHOOK_URL=

# Telegram bot token (crear con @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF...

# Storage backend para LEADS/CRM: "excel" (local) | "sheets" (Google Sheets)
STORAGE_BACKEND=excel
# Solo para sheets: ID del spreadsheet (de la URL) + JSON del service account
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json
# Opcional: Google Sheet con las fichas técnicas (tarifas, habitaciones,
# políticas, upsells). Vacío = leer src/data/hotels/*.xlsx
FICHAS_SHEET_ID=
# Credenciales inline para deploys sin archivo (contenido completo del JSON)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Chat de Telegram del asesor que valida grupos con botones.
# Vacío = consola si es interactiva, auto-aprobar si headless.
ADVISOR_CHAT_ID=
ADVISOR_TIMEOUT_S=600

# Persistencia de conversaciones (LangGraph checkpointer)
CHECKPOINT_DB=./output/checkpoints.sqlite
# En Railway con volumen: OUTPUT_DIR=/data/output y CHECKPOINT_DB=/data/checkpoints.sqlite
OUTPUT_DIR=
