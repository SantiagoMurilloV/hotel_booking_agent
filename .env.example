# LLM provider (swappable: deepseek | anthropic | groq | openai ...)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-...

# Slack incoming webhook (opcional: sin él, las notificaciones van a consola)
SLACK_WEBHOOK_URL=

# Telegram bot token (crear con @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF...

# Storage backend para LEADS/CRM: "excel" (local) | "sheets" (Google Sheets)
STORAGE_BACKEND=excel
# Solo para sheets: ID del spreadsheet (de la URL) + JSON del service account
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json
